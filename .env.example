# Copy this file to .env and fill in your values (.env is NOT committed)

# How many bookings to make in one run (1 while debugging, 40 for the final run)
BOOKING_COUNT=1

# Base email for bookings. Each booking gets a unique alias: name+valtive-<run>-<n>@domain
# Use your own mailbox (Gmail supports "+" aliases)
BOOKER_EMAIL=your.name@gmail.com
BOOKER_FIRST_NAME=QA
BOOKER_LAST_NAME=Automation

# Qase TMS (https://app.qase.io -> Workspace -> API tokens)
QASE_MODE=off
QASE_TESTOPS_API_TOKEN=
QASE_TESTOPS_PROJECT=

# MailSlurp test inboxes (https://app.mailslurp.com -> API key)
# 1) put your key here  2) run: npm run inboxes:create  3) paste the printed IDs below
MAILSLURP_API_KEY=
MAILSLURP_INBOX_IDS=

# Cancel every booking after the test (cleanup fixture). Set to false to keep bookings.
CANCEL_AFTER_TEST=true
